<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <title>Board Games Database</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * {
            font-family: "Source Sans Pro", sans-serif;
        }

        :root {
            --bs-purple-800: #2c1a4d;
        }

        article::before {
            margin-left: -12px;
            margin-right: -12px;
            background: url("data:image/jpg;base64,<%= data['show']; %>") no-repeat center center fixed;
            content: '';
            z-index: -1;
            width: 100%;
            height: 100%;
            position: absolute;
            -webkit-background-size: cover;
            /*-webkit-filter: blur(100px);*/
            opacity: 0.15;
        }

        .bg-purple-800 {
            background-color: var(--bs-purple-800);
        }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg bg-purple-800">
    <div class="container-fluid justify-content-center">
        <a class="navbar-brand" href="#">
            <i class="bi bi-dice-4-fill pe-1"></i>
            <b>Game Night</b>
        </a>
    </div>
</nav>
<article class="container-fluid">
    <div class="row pt-2">
        <div class="col-3 justify-content-center">
            <img class="img-fluid rounded" src="data:/image/jpg;base64,<%- data['box'] %>" alt="">
        </div>
        <div class="col-9">
            <div class="row align-items-center justify-content-between">
                <h1 class="col"><%= data["Naslov"]; %>
                    <span class="text-secondary">(<%= data["Godina"]; %>)</span>
                </h1>
            </div>

            <% let desc; %>
            <% if (data["Opis (HR)"].length) { %>
                <% desc = data["Opis (HR)"]; %>
            <% } else { %>
                <% desc = data["Opis (EN)"]; %>
            <% } %>
            <p><%= desc; %></p>

            <dl class="row">
                <dt class="col-auto">
                    Ocjena:
                </dt>
                <dd class="col">
            <span class="fs-1">
                <i class="bi bi-hexagon-fill text-warning"></i>
            </span>
                </dd>
            </dl>

            <dl class="row">
                <dt class="col-auto">
                    Br. igrača:
                </dt>
                <% let minPlayers = data['Min. br. igrača']; %>
                <% minPlayers = Math.max(minPlayers, 2); %>
                <% let maxPlayers = data['Max. br. igrača']; %>

                <% if (minPlayers === maxPlayers) { %>
                <dd class="col">
                    <% } else { %>
                <dd class="col" style="margin-top: -4px;">
                    <% } %>
                    <% for (let i = 0; i < minPlayers; i++) { %>
                        <i class="bi bi-person-fill" style="margin-right: -6px;"></i>
                    <% } %>
                    <% if (minPlayers !== maxPlayers) { %>
                        <span class="text-secondary fs-5" style="margin-right: -6px;">(</span>
                        <% for (let i = minPlayers; i < maxPlayers; i++) { %>
                            <i class="bi bi-person-fill text-secondary" style="margin-right: -6px;"></i>
                        <% } %>
                        <span class="text-secondary fs-5">)</span>
                    <% } %>
                </dd>

                <dt class="col-auto">
                    Trajanje:
                </dt>
                <dd class="col">
                    <% let duration = data["Trajanje (min)"]; %>
                    <i class="bi bi-hourglass" style="margin-right: -6px;"></i>
                    <% if (duration > 20) { %>
                        <i class="bi bi-hourglass" style="margin-right: -6px;"></i>
                    <% } else { %>
                        <i class="bi bi-hourglass text-secondary" style="margin-right: -6px;"></i>
                    <% } %>
                    <% if (duration > 30) { %>
                        <i class="bi bi-hourglass" style="margin-right: -6px;"></i>
                    <% } else { %>
                        <i class="bi bi-hourglass text-secondary" style="margin-right: -6px;"></i>
                    <% } %>
                </dd>

                <dt class="col-auto">
                    Težina:
                </dt>
                <dd class="col">
                    <% let weight = data["Težina (5)"]; %>
                    <% let numWeight = Math.floor(2 * (weight - 0.5)); %>
                    <% for (let i = 0; i < numWeight; i++ ){ %>
                        <i class="bi bi-lightning-charge-fill" style="margin-right: -6px;"></i>
                    <% } %>
                    <% for (let i = numWeight; i < 5; i++ ){ %>
                        <i class="bi bi-lightning-charge-fill text-secondary" style="margin-right: -6px;"></i>
                    <% } %>
                </dd>
            </dl>
        </div>
    </div>
</article>
</body>
</html>