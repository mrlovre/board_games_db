<!DOCTYPE html>
<%
    const rating = data['Ocjena (10)'];
    const tiers = [
        [0, 'Common', '#6c757d', '#ffffff'],
        [5.0, 'Uncommon', '#f8f9fa', '#182026'],
        [5.8, 'Special', '#20c997', '#102c24'],
        [7.0, 'Rare', '#198754', '#ffffff'],
        [7.3, 'Epic', '#0dcaf0', '#102c34'],
        [7.5, 'Mythic', '#0d6efd', '#ffffff'],
        [7.9, 'Legendary', '#6f42c1', '#ffffff']
    ];
    const tier = tiers.filter(([minimum]) => rating >= minimum).pop() || tiers[0];
    const [, ratingText, accent, contrast] = tier;
    const icon = name => include('node_modules/bootstrap-icons/icons/' + name + '.svg');
    const title = data['Naslov'];
    const minPlayers = data['Min. br. igrača'];
    const maxPlayers = data['Max. br. igrača'];
    const duration = data['Trajanje (min)'];
    const weight = data['Težina (5)'];
    const popularity = data['BGG Ocjena (10)'];
    const numWeight = Number.isFinite(weight) ? Math.max(0, Math.min(Math.floor(2 * (weight - 0.5)), 5)) : 0;
    const numPop = Number.isFinite(popularity) ? Math.max(0, Math.min(Math.floor(2 * (popularity - 5)), 5)) : 0;
%>
<html lang="hr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> — Game Night</title>
    <style>
        * { box-sizing: border-box; }
        :root {
            --accent: <%= accent %>;
            --contrast: <%= contrast %>;
            --text: #eef1f4;
            --muted: #b5bec8;
            --blue: #66a8ff;
            --cyan: #36d8f4;
            --green: #3bc88b;
            --yellow: #ffd24a;
            --orange: #ffa34e;
        }
        body {
            margin: 0;
            width: 768px;
            height: 620px;
            font-family: "Source Sans Pro", "Segoe UI", Arial, sans-serif;
            color: var(--text);
            background: #20272d;
        }
        svg { width: 1em; height: 1em; fill: currentColor; flex-shrink: 0; }
        .game-title {
            height: 80px;
            display: flex;
            align-items: center;
            padding: 14px 24px;
            background: var(--accent);
            color: var(--contrast);
        }
        h1 {
            margin: 0;
            font-size: <%= title.length > 55 ? 28 : title.length > 35 ? 31 : 36 %>px;
            font-weight: 750;
            line-height: 1.12;
            letter-spacing: -0.6px;
            text-wrap: balance;
        }
        .card-body {
            position: relative;
            isolation: isolate;
            height: 524px;
            padding: 22px 20px;
            display: grid;
            grid-template-columns: 168px minmax(0, 1fr);
            gap: 24px;
            background: color-mix(in srgb, var(--accent) 7%, #20272d);
        }
        .card-body::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background: url("data:image/jpeg;base64,<%= data['show'] %>") center / cover;
            opacity: 0.13;
        }
        .cover-column { display: flex; flex-direction: column; min-height: 0; }
        .cover {
            display: block;
            width: 100%;
            max-height: 375px;
            object-fit: contain;
            object-position: top;
            border-radius: 5px;
        }
        .game-night {
            margin-top: auto;
            padding-top: 16px;
            border-top: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
            color: var(--accent);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
        }
        .game-night svg { font-size: 25px; }
        .game-night span {
            font-size: 20px;
            font-weight: 800;
            font-variant: small-caps;
            line-height: 1.05;
            text-align: center;
            letter-spacing: 0.8px;
        }
        .details {
            min-width: 0;
            display: grid;
            grid-template-rows: auto minmax(0, 1fr) 100px 188px;
            gap: 16px;
        }
        .genres {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 8px;
        }
        .genre {
            border: 2px solid var(--muted);
            border-radius: 4px;
            padding: 4px 8px;
        }
        .credits { 
            margin: 0;
            color: var(--muted);
        }
        .credits span + span::before {
            content: ' · ';
            padding: 0 3px;
        }
        .description { margin: 0; font-size: 18px; font-weight: 600; line-height: 1.4; }
        .panel {
            background: rgba(25, 31, 38, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.09);
            border-radius: 6px;
        }
        .rating {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
            justify-content: center;
            gap: 16px;
        }
        .rating-label { font-size: 24px; font-weight: 750; font-variant: small-caps; justify-self: right; }
        .rating-badge { position: relative; color: var(--accent); width: 76px; height: 82px; }
        .rating-badge svg { width: 100%; height: 100%; }
        .rating-value {
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
            font-size: 30px;
            font-weight: 800;
            color: var(--contrast);
        }
        .rating-tier { color: var(--accent); font-size: 25px; font-weight: 750; font-variant: small-caps; justify-self: left; }
        .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .metric { padding: 10px 12px; min-width: 0; }
        .metric h2 {
            margin: 0 0 8px;
            font-size: 12px;
            line-height: 1;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }
        .metric-content { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
        .icons { display: flex; align-items: center; gap: 4px; font-size: 28px; }
        .icons .inactive { color: #55616d; }
        .metric-value { font-size: 18px; font-weight: 700; white-space: nowrap; }
        .metric-value small { font-size: 11px; font-weight: 500; }
        .players { color: var(--blue); }
        .players .additional { color: var(--cyan); }
        .players .icons { gap: 0; font-size: 28px; }
        .time { color: var(--yellow); }
        .weight { color: var(--green); }
        .popularity { color: var(--orange); }
        .weight .icons, .popularity .icons { font-size: 28px; }
    </style>
</head>
<body>
<header class="game-title"><h1><%= title %></h1></header>
<main class="card-body">
    <aside class="cover-column">
        <img class="cover" src="data:image/jpeg;base64,<%= data['box'] %>" alt="<%= title %> — naslovnica">
        <div class="game-night" aria-label="Game Night">
            <%- icon('dice-4-fill') %><span>Game<br>Night</span><%- icon('dice-3-fill') %>
        </div>
    </aside>
    <section class="details" aria-label="Podaci o igri">
        <div class="metadata">
            <div class="genres">
                <% for (const genre of (data['Žanr'] || '').split(',').filter(Boolean)) { %>
                    <span class="genre"><%= genre.trim() %></span>
                <% } %>
            </div>
            <p class="credits">
                <% for (const value of [data['Dizajner'], data['Izdavač'], data['Godina']].filter(Boolean)) { %>
                    <span><%= value %></span>
                <% } %>
            </p>
        </div>
        <p class="description"><%= data['Opis (HR)'] || data['Opis (EN)'] %></p>
        <div class="panel rating">
            <span class="rating-label">Ocjena:</span>
            <span class="rating-badge">
                <%- icon('hexagon-fill') %>
                <span class="rating-value"><%= Number.isFinite(rating) ? rating.toFixed(1) : '—' %></span>
            </span>
            <span class="rating-tier"><%= ratingText %></span>
        </div>
        <div class="metrics">
            <div class="panel metric players">
                <h2>Broj igrača</h2>
                <div class="metric-content">
                    <span class="icons" aria-hidden="true">
                        <% for (let i = 0; i < (maxPlayers > 8 ? 8 : maxPlayers); i++) { %>
                            <span class="<%= i >= minPlayers ? 'additional' : '' %>"><%- icon('person-fill') %></span>
                        <% } %>
                    </span>
                </div>
            </div>
            <div class="panel metric time">
                <h2>Vrijeme</h2>
                <div class="metric-content">
                    <span class="icons" aria-hidden="true">
                        <% for (let i = 0; i < 3; i++) { %>
                            <span class="<%= i === 0 || (i === 1 && duration > 20) || (i === 2 && duration > 30) ? '' : 'inactive' %>"><%- icon('alarm-fill') %></span>
                        <% } %>
                    </span>
                </div>
            </div>
            <div class="panel metric weight">
                <h2>Težina</h2>
                <div class="metric-content">
                    <span class="icons" aria-hidden="true">
                        <% for (let i = 0; i < 5; i++) { %>
                            <span class="<%= i < numWeight ? '' : 'inactive' %>"><%- icon('puzzle-fill') %></span>
                        <% } %>
                    </span>
                </div>
            </div>
            <div class="panel metric popularity">
                <h2>Popularnost</h2>
                <div class="metric-content">
                    <span class="icons" aria-hidden="true">
                        <% for (let i = 0; i < 5; i++) { %>
                            <span class="<%= i < numPop ? '' : 'inactive' %>"><%- icon('fire') %></span>
                        <% } %>
                    </span>
                </div>
            </div>
        </div>
    </section>
</main>
</body>
</html>
