<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <title>IBMiLS</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        * {
            font-family: "Source Sans Pro";
        }

        input.form-control::placeholder {
            color: rgba(52, 58, 64, 0.5) !important;
        }

        article::before {
            background: url("data:image/png;base64,<%= thumbnailBase64; %>") no-repeat center center fixed;
            content: '';
            z-index: -1;
            width: 100%;
            height: 100%;
            position: absolute;
            -webkit-background-size: cover;
            -webkit-filter: blur(100px);
            opacity: 0.4;
        }

        dd {
            margin-bottom: 0;
        }
    </style>
</head>
<body>
<nav class="container mx-auto px-0">
    <header class="navbar bg-dark align-items-center justify-content-center justify-content-md-between py-4 px-4 mb-4 border-bottom"
            style="margin-left: -24px; margin-right: -24px;">
        <div class="col-auto mb-2 mb-md-0">
            <label aria-haspopup="true" id="imdbHeader-navDrawerOpen"
                   class="px-2"
                   tabindex="0" aria-label="Open Navigation Drawer" aria-disabled="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                     class="ipc-icon ipc-icon--menu ipc-responsive-button__icon" viewBox="0 0 24 24"
                     fill="currentColor"
                     role="presentation">
                    <path fill="none" d="M0 0h24v24H0V0z"></path>
                    <path d="M4 18h16c.55 0 1-.45 1-1s-.45-1-1-1H4c-.55 0-1 .45-1 1s.45 1 1 1zm0-5h16c.55 0 1-.45 1-1s-.45-1-1-1H4c-.55 0-1 .45-1 1s.45 1 1 1zM3 7c0 .55.45 1 1 1h16c.55 0 1-.45 1-1s-.45-1-1-1H4c-.55 0-1 .45-1 1z"></path>
                </svg>
            </label>
            <button type="button" class="btn btn-warning">
                <span class="fw-bold">IBMiLS</span>
            </button>
        </div>

        <div class="col mx-4">
            <div class="input-group">

                <input type="text" class="form-control text-bg-light"
                       placeholder="Pretraži Internetsku Bazu Mislavovih i Lukinih Sranja"
                       aria-label="dummy">
                <span class="input-group-text text-bg-light text-secondary" id="basic-addon1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                       class="bi bi-search" viewBox="0 0 16 16">
  <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"></path>
</svg>
                </span>
            </div>
        </div>

        <div class="col-auto text-end">
            <button type="button" class="btn btn-outline-light me-1">Prijavi se</button>
        </div>
    </header>
</nav>

<article class="container mx-auto px-0">
    <div class="row align-items-center">
        <div class="col">
            <h1 class="mb-0 fw-semibold"><%= title; %></h1>
        </div>
        <div class="col-auto">
            <button type="button" class="btn btn-warning btn-small py-0 px-1 me-1 fw-bold"><%= tagline; %></button>
        </div>
    </div>
    <div class="row mb-2 align-items-center">
        <ul class="col mb-0 list-inline text-secondary">
            <li class="list-inline-item"><%= year; %></li>
            <li class="list-inline-item">&bull;</li>
            <li class="list-inline-item"><%= pgRating; %></li>
            <li class="list-inline-item">&bull;</li>
            <li class="list-inline-item"><%= duration; %></li>
        </ul>

        <div class="col-auto">
            <div class="row gx-0 align-items-center justify-content-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                     class="col-auto me-1" viewBox="0 0 24 24" fill="#ffc107"
                     role="presentation">
                    <path d="M12 17.27l4.15 2.51c.76.46 1.69-.22 1.49-1.08l-1.1-4.72 3.67-3.18c.67-.58.31-1.68-.57-1.75l-4.83-.41-1.89-4.46c-.34-.81-1.5-.81-1.84 0L9.19 8.63l-4.83.41c-.88.07-1.24 1.17-.57 1.75l3.67 3.18-1.1 4.72c-.2.86.73 1.54 1.49 1.08l4.15-2.5z"></path>
                </svg>
                <span class="col-auto text-light"><%= avgRating; %></span>
                <span class="col-auto text-secondary">/10</span>
                <span class="col-auto me-4"></span>
                <span class="col-auto text-secondary"><%= noRatings; %> ocjena</span>
            </div>
        </div>

        <div class="col-auto text-end list-inline text-secondary">
            <% for (const genre of genres) { %>
                <button type="button" class="btn btn-outline-secondary btn-sm me-1 py-0 px-1"><%= genre; %></button>
            <% } %>
        </div>
    </div>

    <div class="row">
        <div class="col-3">
            <img class="img-fluid rounded" src="data:image/png;base64,<%= thumbnailBase64; %>" alt="">
        </div>
        <div class="col-9">
            <p class="mb-2 pb-2 border-bottom"><%- summary; %></p>
            <div class="mb-2 pb-2 border-bottom">
                <% if (roles) { %>
                    <button class="btn btn-sm bg-dark fw-bold py-0 px-1 mb-1" type="button"
                            style="margin-left: -0.25rem;">
                        Glavne uloge
                    </button>
                    <br>
                    <% for (const role of roles) { %>
                        <dl class="row mb-0">
                            <dt class="col-3 text-primary">
                                <%= role.name; %>
                            </dt>
                            <dd class="col-9">
                                <%= role.characters.join(" / ") %>
                            </dd>
                        </dl>
                    <% } %>
                <% } %>
            </div>
            <% if (trivia.length) { %>
                <p class="mb-1 pb-1">
                    <button class="btn btn-sm bg-dark fw-bold py-0 px-1" type="button"
                            style="margin-left: -0.25rem;">
                        Zanimljivosti
                    </button>
                    <br>
                    <%- trivia; %>
                </p>
            <% } %>
            <% if (quotes.length) { %>
                <p class="mb-2 pb-1">
                    <button class="btn btn-sm bg-dark fw-bold py-0 px-1" type="button"
                            style="margin-left: -0.25rem;">
                        Nezaboravni citati
                    </button>
                    <br>
                    <%- quotes.join(""); %>
                </p>
            <% } %>
            <p class="mb-0 pb-2"></p>
        </div>
    </div>

</article>
<div class="container-fluid px-0">
    <% if (reviewTitle) { %>
    <div class="p-4 bg-light text-dark">
        <div class="d-flex mb-2">
            <div class="text-warning fw-bold vr"
                 style="margin-left: -0.5rem; margin-right: 0.25rem; width: 0.25rem; opacity: 1;"></div>
            <h2 class="pb-0 mb-0">Recenzije (<%= numReviews; %>)</h2>
        </div>
        <div class="row">
            <div class="col d-flex mb-2">
                <h5 class="mb-0 me-2"><b><%- reviewTitle; %></b></h5>
                <button type="button" class="btn btn-sm btn-warning fw-bold py-0 px-1">Top recenzija</button>
            </div>
            <div class="col-auto align-items-center justify-content-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                     class="col-auto me-1" viewBox="0 0 24 24" fill="#ffc107"
                     role="presentation">
                    <path d="M12 17.27l4.15 2.51c.76.46 1.69-.22 1.49-1.08l-1.1-4.72 3.67-3.18c.67-.58.31-1.68-.57-1.75l-4.83-.41-1.89-4.46c-.34-.81-1.5-.81-1.84 0L9.19 8.63l-4.83.41c-.88.07-1.24 1.17-.57 1.75l3.67 3.18-1.1 4.72c-.2.86.73 1.54 1.49 1.08l4.15-2.5z"></path>
                </svg>
                <span class="col-auto text-dark"><%= reviewRating; %></span>
                <wbr>
                <span class="col-auto text-secondary">/10</span>
            </div>
            <p><%= reviewBody; %></p>
        </div>
        <% } else { %>
        <div class="p-4 bg-light text-dark">
            <div class="d-flex mb-2">
                <div class="text-warning fw-bold vr"
                     style="margin-left: -0.5rem; margin-right: 0.25rem; width: 0.25rem; opacity: 1;"></div>
                <h2 class="pb-0 mb-0">Recenzije</h2>
            </div>
            <div class="row alert alert-light px-0">
                <div class="col d-flex mb-2">
                    <h5 class="mb-0 me-2 alert-heading"><b class="text-warning">Još nema recenzija...</b></h5>
                </div>
                <p class="mb-0">Hej, čini se da još nema ničeg ovdje. Želiš li prvi podijeliti svoje mišljenje? <a
                            class="alert-link" href="#">Dodaj recenziju...</a></p>
            </div>
            <% } %>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
</body>
</html>

